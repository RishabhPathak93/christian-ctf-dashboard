# Copy these into Vercel → Project → Settings → Environment Variables.
# (For local `vercel dev`, put them in a .env file — do NOT commit real values.)

# Admin dashboard password (/admin). Change this.
CTF_ADMIN_PASSWORD=change-me-to-something-strong

# Secret used to sign session cookies. Any long random string. Change this.
CTF_SECRET_KEY=change-me-to-a-long-random-string

# Upstash Redis REST credentials (from the Upstash console, or auto-set if you
# add Upstash via the Vercel Marketplace integration — then KV_* vars are used).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
